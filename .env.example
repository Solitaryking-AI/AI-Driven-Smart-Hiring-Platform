# SmartHire AI - Environment Variables Template

# Sarvam AI API Key (Get yours at https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# JWT Authentication Secret Key
SMARTHIRE_SECRET_KEY=your_secure_secret_key_here

# Optional: Sarvam model (defaults to sarvam-105b)
# SARVAM_MODEL=sarvam-105b

# Optional Alternative: Anthropic Claude API Key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Initial Bootstrap Administrator (created once on startup if no admin exists)
# BOOTSTRAP_ADMIN_EMAIL=admin@smarthire.local
# BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePassword123!

# Optional: Backend API Base URL (defaults to http://127.0.0.1:8000)
# API_BASE_URL=http://127.0.0.1:8000


